# AERO-SHIELD Console — environment template.
# Copy to .env and adjust for your local backend.

# Base URL of the FastAPI backend (see backend/app/main.py).
# No trailing slash.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Request timeout in milliseconds for the shared Axios client.
VITE_API_TIMEOUT_MS=15000
