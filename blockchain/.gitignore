# ============================================================
#  AERO-SHIELD X — Blockchain .gitignore
# ============================================================

# ---- Environment & Secrets --------------------------------
.env
*.pem
*.key
*.secret

# ---- Node.js ----------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn

# ---- Hardhat Build Artefacts ------------------------------
# Compiled bytecode and ABIs are regenerated by `npx hardhat compile`.
# Do NOT commit them; they contain absolute local paths in debug info.
artifacts/
cache/
typechain-types/

# ---- Coverage & Gas Reports -------------------------------
coverage/
coverage.json
gas-report.txt
lcov.info

# ---- Deployment Records -----------------------------------
# Commit these ONLY when you want the team to share a known
# deployment address. For local Ganache deployments, exclude.
# deployment/
# abi/
# (Uncomment the two lines above to exclude generated files.)

# ---- OS artefacts -----------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---- IDE / Editor -----------------------------------------
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- Temporary files --------------------------------------
*.log
*.tmp
*.bak
