# ============================================================
#  AERO-SHIELD X — Blockchain Environment Variables
#  Copy this file to .env and fill in the values.
#  NEVER commit .env to version control.
# ============================================================

# ----------------------------------------------------------
#  Ganache — Local Ethereum Network
#
#  RPC URL : The HTTP endpoint that Hardhat and Web3.py use
#            to communicate with your Ganache instance.
#            Ganache GUI default  → http://127.0.0.1:7545
#            Ganache CLI default  → http://127.0.0.1:8545
# ----------------------------------------------------------
GANACHE_RPC_URL=http://127.0.0.1:7545

# ----------------------------------------------------------
#  Private Key
#
#  One of the accounts generated by Ganache.
#  Copy it from the Ganache GUI (key icon) or from the
#  CLI output ("Private Keys" section).
#
#  This account pays gas for deployments and transactions.
#
#  FORMAT: 64 hex characters, WITH the 0x prefix.
#  EXAMPLE: 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# ----------------------------------------------------------
PRIVATE_KEY=0x4383686cee49b1020f1e8f4de187454dfb27c82c14d5d1f81377f6107addc58c

# ----------------------------------------------------------
#  Chain ID
#
#  The network identifier that prevents replay attacks across
#  different Ethereum networks.
#
#  Ganache GUI default  → 1337
#  Ganache CLI default  → 1337
#  Hardhat built-in     → 31337
#
#  Must match the chainId set in Ganache settings AND in
#  hardhat.config.js.
# ----------------------------------------------------------
CHAIN_ID=1337

# ----------------------------------------------------------
#  Contract Owner
#
#  The Ethereum address (checksummed) that will be recorded
#  as the owner/admin of the deployed EvidenceVault contract.
#  Normally this is the public address corresponding to
#  PRIVATE_KEY above.
#
#  FORMAT: 42 hex characters (0x + 40 chars)
# ----------------------------------------------------------
CONTRACT_OWNER=0x009DD4C18D28Fa147306adc2bf698579607ea20b
# ----------------------------------------------------------
#  Gas Reporter (optional)
#
#  Set to "true" to print a gas-usage table after tests.
#  Requires COINMARKETCAP_API_KEY for USD conversion.
# ----------------------------------------------------------
REPORT_GAS=false
COINMARKETCAP_API_KEY=

# ----------------------------------------------------------
#  Future — Testnet / Mainnet (Phase 3+)
# ----------------------------------------------------------
# SEPOLIA_RPC_URL=
# MAINNET_RPC_URL=
# ETHERSCAN_API_KEY=
