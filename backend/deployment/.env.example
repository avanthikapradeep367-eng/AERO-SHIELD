# AERO-SHIELD X — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.

# ── PostgreSQL ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://aeroshield:aeroshield@localhost:5432/aeroshield

# ── Ethereum / Ganache ──────────────────────────────────────────────────────
GANACHE_RPC_URL=http://127.0.0.1:7545
PRIVATE_KEY=0x<your_wallet_private_key>
WALLET_ADDRESS=0x<your_wallet_address>
CHAIN_ID=1337
CONTRACT_ADDRESS=0x<deployed_contract_address>

# ── Application ─────────────────────────────────────────────────────────────
APP_ENV=production
SECRET_KEY=<generate_with_openssl_rand_hex_32>
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ── SentinelX AI Engine (Member 3) ──────────────────────────────────────────
AI_ENGINE_URL=http://localhost:8001
